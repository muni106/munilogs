---
import { getVaultTree, type VaultNode } from "@/utils/getVaultTree";
import Socials from "@/components/Socials.astro";
import IconFolder from "@/assets/icons/IconFolder.svg";
import IconFolderOpen from "@/assets/icons/IconFolderOpen.svg";
import { SITE } from "@/config";

const tree = await getVaultTree();

const { pathname } = Astro.url;
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isCurrent = (href: string) => currentPath === href;

/** A folder is open when the page lives inside it. */
const isOpen = (node: VaultNode) =>
  currentPath === node.href || currentPath.startsWith(`${node.href}/`);
---

<aside id="vault-sidebar" class="sidebar" data-open="false">
  <a href="/" class:list={["sidebar__vault", { "is-current": isCurrent("/") }]}>
    <span class="sidebar__vault-icon" aria-hidden="true">◆</span>
    {SITE.title}
  </a>

  <nav class="sidebar__nav" aria-label="Vault">
    <ul class="sidebar__list">
      {
        tree.map(node =>
          node.children && node.children.length > 0 ? (
            <li>
              <details open={isOpen(node)} class="sidebar__folder" data-section={node.section}>
                <summary class="sidebar__chip">
                  <span class="sidebar__folder-icon" aria-hidden="true">
                    <IconFolder class="ico ico--closed" />
                    <IconFolderOpen class="ico ico--open" />
                  </span>
                  {node.label}
                </summary>
                <ul class="sidebar__children">
                  {node.children.map((child, i) => (
                    <li style={`--i:${i}`}>
                      <a
                        href={child.href}
                        class:list={["sidebar__leaf", { "is-current": isCurrent(child.href) }]}
                        {...(child.external
                          ? { target: "_blank", rel: "noopener noreferrer" }
                          : {})}
                      >
                        {child.label}
                        {child.external && (
                          <span class="sidebar__ext" aria-hidden="true">
                            ↗
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
                <a href={node.href} class="sidebar__all">
                  all {node.label} →
                </a>
              </details>
            </li>
          ) : (
            <li>
              <a
                href={node.href}
                data-section={node.section}
                class:list={["sidebar__file", { "is-current": isOpen(node) }]}
              >
                {node.label}
              </a>
            </li>
          )
        )
      }
    </ul>
  </nav>

  <!-- Socials + copyright live at the foot of the vault, as the old footer did. -->
  <div class="sidebar__foot">
    <Socials />
    <p class="sidebar__copy">&#169; {new Date().getFullYear()} {SITE.author}</p>
  </div>
</aside>

<!-- Click-catcher behind the mobile drawer -->
<div id="sidebar-scrim" class="sidebar-scrim" hidden></div>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    width: 15.5rem;
    padding: 0.75rem;
    overflow-y: auto;
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 0.625rem;
    font-size: 0.8rem;
  }

  .sidebar__nav {
    flex: 1;
  }

  .sidebar__foot {
    margin-top: 1.25rem;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--border);
  }
  .sidebar__copy {
    margin: 0.25rem 0 0;
    font-size: 0.65rem;
    opacity: 0.6;
  }

  /* ===== Vault name ===== */
  .sidebar__vault {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.6rem;
    margin-bottom: 0.6rem;
    border-radius: 0.45rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--headings);
  }
  .sidebar__vault:hover,
  .sidebar__vault.is-current {
    background: color-mix(in srgb, var(--border) 25%, transparent);
  }
  .sidebar__vault-icon {
    font-size: 0.7rem;
    opacity: 0.7;
  }

  /* ===== Tree ===== */
  .sidebar__list,
  .sidebar__children {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  /* Coloured folder row — the reference's tinted chips. */
  .sidebar__chip {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.55rem;
    border: 2px solid var(--sec-line);
    border-radius: 0.45rem;
    background: var(--sec-fill);
    color: var(--foreground);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }
  .sidebar__chip::-webkit-details-marker {
    display: none;
  }
  .sidebar__folder[open] > .sidebar__chip {
    box-shadow: inset 3px 0 0 var(--sec-line);
  }

  /* Folder glyph: filled folder when shut, open folder when expanded. Both
     glyphs sit in the same grid cell and cross-fade with a lid-flip. */
  .sidebar__folder-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 0.95rem;
    height: 0.95rem;
    color: var(--sec-line);
  }
  .sidebar__folder-icon :global(.ico) {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    transition:
      opacity 0.18s ease,
      transform 0.3s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .sidebar__folder-icon :global(.ico--closed) {
    fill: currentColor;
    fill-opacity: 0.22;
  }
  .sidebar__folder-icon :global(.ico--open) {
    opacity: 0;
    transform: scale(0.72) rotate(-14deg);
    transform-origin: 20% 80%;
  }
  [open] > .sidebar__chip .sidebar__folder-icon :global(.ico--closed) {
    opacity: 0;
    transform: scale(0.72) rotate(10deg);
  }
  [open] > .sidebar__chip .sidebar__folder-icon :global(.ico--open) {
    opacity: 1;
    transform: none;
  }

  /* Body reveal. ::details-content is what makes a <details> animatable at all;
     browsers without it just snap open, which is fine. */
  .sidebar__folder::details-content {
    block-size: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      block-size 0.3s cubic-bezier(0.32, 0.72, 0, 1),
      opacity 0.2s ease,
      content-visibility 0.3s allow-discrete;
  }
  .sidebar__folder[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  /* Rows slide in one after another as the folder opens. */
  @keyframes vault-leaf-in {
    from {
      opacity: 0;
      transform: translateX(-4px);
    }
  }
  .sidebar__folder[open] .sidebar__children > li {
    animation: vault-leaf-in 0.24s both;
    animation-delay: calc(min(var(--i, 0), 10) * 28ms);
  }

  /* Folder body — dashed guide line, as in the reference. */
  .sidebar__folder[open] {
    border-inline-start: 2px dashed var(--sec-line);
    border-radius: 0.45rem;
    margin-inline-start: 0.1rem;
    padding: 0 0 0.3rem 0.35rem;
  }
  .sidebar__folder[open] > .sidebar__chip {
    margin-inline-start: -0.35rem;
  }
  .sidebar__children {
    padding: 0.35rem 0 0 0.5rem;
  }

  .sidebar__leaf {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.22rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 0.35rem;
    color: var(--foreground);
    text-decoration: none;
    line-height: 1.35;
  }
  .sidebar__leaf:hover {
    background: color-mix(in srgb, var(--sec-fill) 70%, transparent);
    border-color: color-mix(in srgb, var(--sec-line) 50%, transparent);
  }
  .sidebar__leaf.is-current {
    background: var(--sec-fill);
    border-color: var(--sec-line);
    font-weight: 600;
  }
  .sidebar__ext {
    font-size: 0.6rem;
    opacity: 0.55;
  }

  /* Loose files: no tint, thin outline, sitting under the folders. */
  .sidebar__file {
    display: flex;
    align-items: center;
    margin-inline-start: 0.5rem;
    padding: 0.22rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
    border-radius: 0.35rem;
    color: var(--foreground);
    text-decoration: none;
    line-height: 1.35;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }
  .sidebar__file:hover {
    background: color-mix(in srgb, var(--sec-fill) 60%, transparent);
    border-color: color-mix(in srgb, var(--sec-line) 50%, transparent);
  }
  .sidebar__file.is-current {
    background: var(--sec-fill);
    border-color: var(--sec-line);
    font-weight: 600;
  }
  /* Breathing room where the folders end and the loose files begin. */
  li:has(.sidebar__folder) + li:has(> .sidebar__file) {
    margin-top: 0.5rem;
  }

  .sidebar__all {
    display: inline-block;
    margin: 0.4rem 0 0 0.5rem;
    font-size: 0.7rem;
    color: var(--foreground);
    opacity: 0.6;
    text-decoration: none;
  }
  .sidebar__all:hover {
    opacity: 1;
    text-decoration: underline;
  }

  /* ===== Section colour families ===== */
  [data-section="blog"] {
    --sec-fill: var(--sec-blog-fill);
    --sec-line: var(--sec-blog-line);
  }
  [data-section="notes"] {
    --sec-fill: var(--sec-notes-fill);
    --sec-line: var(--sec-notes-line);
  }
  [data-section="projects"] {
    --sec-fill: var(--sec-projects-fill);
    --sec-line: var(--sec-projects-line);
  }
  [data-section="tags"] {
    --sec-fill: var(--sec-tags-fill);
    --sec-line: var(--sec-tags-line);
  }
  [data-section="home"] {
    --sec-fill: var(--sec-home-fill);
    --sec-line: var(--sec-home-line);
  }

  /* ===== Mobile drawer ===== */
  .sidebar-scrim {
    display: none;
  }

  @media (max-width: 899px) {
    .sidebar {
      position: fixed;
      inset-block: 0;
      inset-inline-start: 0;
      z-index: 50;
      width: 17rem;
      max-width: 85vw;
      border-radius: 0;
      transform: translateX(-102%);
      transition: transform 0.22s ease;
    }
    .sidebar[data-open="true"] {
      transform: translateX(0);
    }
    .sidebar-scrim {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 49;
      background: rgb(0 0 0 / 0.35);
    }
    .sidebar-scrim[hidden] {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar,
    .sidebar__file,
    .sidebar__folder::details-content,
    .sidebar__folder-icon :global(.ico) {
      transition: none;
    }
    .sidebar__folder[open] .sidebar__children > li {
      animation: none;
    }
  }
</style>

<script>
  function initSidebar() {
    const btn = document.getElementById("sidebar-btn");
    const sidebar = document.getElementById("vault-sidebar");
    const scrim = document.getElementById("sidebar-scrim");
    if (!btn || !sidebar || !scrim) return;

    const setOpen = (open: boolean) => {
      sidebar.dataset.open = String(open);
      scrim.hidden = !open;
      btn.setAttribute("aria-expanded", String(open));
    };

    btn.addEventListener("click", () =>
      setOpen(sidebar.dataset.open !== "true")
    );
    scrim.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", e => {
      if (e.key === "Escape") setOpen(false);
    });

    // Close the drawer when navigating so it never covers the new page.
    sidebar.querySelectorAll("a").forEach(a =>
      a.addEventListener("click", () => setOpen(false))
    );
  }

  initSidebar();
  document.addEventListener("astro:after-swap", initSidebar);
</script>
