---
import type { MarkdownHeading } from "astro";
import { ClientRouter } from "astro:transitions";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { SITE } from "@/config";
import TabBar from "@/components/shell/TabBar.astro";
import Sidebar from "@/components/shell/Sidebar.astro";
import NoteBar from "@/components/shell/NoteBar.astro";
import StatusBar from "@/components/shell/StatusBar.astro";
import { sectionFromPath, type VaultSection } from "@/utils/getVaultTree";
import "@/styles/global.css";

export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  /** Overrides the section inferred from the URL. */
  section?: VaultSection;
  /** Label for the active tab; defaults to the page title. */
  tabTitle?: string;
  /** Article word count, surfaced in the status bar. */
  words?: number;
  /** Article headings, surfaced in the note bar outline menu. */
  headings?: MarkdownHeading[];
  /** "Suggest changes" target for the note bar menu. */
  editUrl?: string;
}

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  section = sectionFromPath(Astro.url.pathname),
  tabTitle,
  words,
  headings,
  editUrl,
} = Astro.props;

// Tabs show the page name alone, without the " | Mounir Samite" suffix.
const activeTabTitle = tabTitle ?? title.split(" | ")[0];

const socialImageURL = new URL(ogImage, Astro.url);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: `${title}`,
  image: `${socialImageURL}`,
  datePublished: `${pubDatetime?.toISOString()}`,
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: `${author}`,
      ...(profile && { url: profile }),
    },
  ],
  logo: {
    "@type": "ImageObject",
    "url": `${SITE.website}/${SITE.logo}`,
    "width": "96",
    "height": "96"
  },
};
---

<!doctype html>
<html
  dir={SITE.dir}
  lang=`${SITE.lang ?? "en"}`
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={`/${SITE.logo}`} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <meta name="theme-color" content="" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />

    <script is:inline src="/toggle-theme.js"></script>
  </head>
  <body>
    <a id="skip-to-content" href="#main-content" class="skip-link">
      Skip to content
    </a>

    <div class="vault">
      <TabBar tabTitle={activeTabTitle} {section} />

      <div class="vault__body">
        <Sidebar />
        <div class="vault-pane">
          <NoteBar {headings} {editUrl} />
          <slot />
        </div>
      </div>

      <StatusBar {section} {words} />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }

  .skip-link {
    position: absolute;
    inset-inline-start: 4rem;
    top: -100%;
    z-index: 60;
    padding: 0.5rem 0.75rem;
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 0.5rem;
    color: var(--accent);
    transition: top 0.2s;
  }
  .skip-link:focus {
    top: 0.5rem;
  }

  /* The window frame. */
  .vault {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100svh;
    background: var(--chrome);
  }

  .vault__body {
    display: flex;
    gap: 0.5rem;
    flex: 1;
    min-height: 0;
    padding: 0 0.5rem 0.5rem;
  }

  /* The document pane — the pale canvas the reading happens on. */
  .vault-pane {
    flex: 1;
    min-width: 0;
    background: var(--background);
    border: 2px solid var(--border);
    border-radius: 0.625rem;
    display: flex;
    flex-direction: column;
  }

  /*
   * Desktop pins the frame to the viewport and scrolls inside the pane, so the
   * tab bar and status bar stay put like a real app window. Mobile keeps native
   * page scrolling — an internally scrolling pane breaks address-bar collapse
   * and momentum scrolling on touch.
   */
  @media (min-width: 900px) {
    html,
    body {
      height: 100%;
      overflow: hidden;
    }
    .vault {
      height: 100svh;
      min-height: 0;
    }
    .vault-pane {
      overflow-y: auto;
    }
  }
</style>
